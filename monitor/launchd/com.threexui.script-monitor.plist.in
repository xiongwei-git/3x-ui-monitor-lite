<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.threexui.script-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/lib/threexui-script-monitor/anomaly_monitor.py</string>
  </array>
  <key>StartInterval</key>
  <integer>@INTERVAL_SECONDS@</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/threexui-script-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/threexui-script-monitor.error.log</string>
</dict>
</plist>
